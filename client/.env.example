# ============================================================
#  ALYSTRO — Client Environment Variables
#  Copy this file to .env.local for development
#  Set these in Vercel dashboard for production
# ============================================================

# Backend API URL — your deployed Vercel backend URL
# In development this is not needed (Vite proxy handles /api)
# In production set this to your backend URL:
VITE_API_URL=https://alystro-api.vercel.app/api/v1
