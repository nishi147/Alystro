# ============================================================
#  ALYSTRO — Server Environment Variables
#  Copy this file to .env and fill in real values
#  NEVER commit .env to git
# ============================================================

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas — replace with your Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alystro?retryWrites=true&w=majority&appName=Alystro

# Your deployed Vercel frontend URL (update after deploying frontend)
CLIENT_URL=https://alystro.vercel.app

# JWT — use a long random string in production
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# Cookie signing
COOKIE_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_IN_PRODUCTION

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
